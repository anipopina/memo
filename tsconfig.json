{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": [
    "spikes/**/*.ts",
    "spikes/**/*.vue",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
