{
  "name": "memo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --config spikes/editor/vite.config.ts",
    "dev:mcp": "tsx spikes/mcp/main.ts",
    "build": "vite build --config spikes/editor/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-document": "3.33.1",
    "@tiptap/extension-link": "3.33.1",
    "@tiptap/extension-paragraph": "3.33.1",
    "@tiptap/extension-text": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/vue-3": "3.33.1",
    "hono": "4.13.18",
    "linkifyjs": "4.4.0",
    "node-diff3": "3.2.1",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
